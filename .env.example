# Credenciais da sua aplicação em https://dashboard.pluggy.ai (Applications → Client ID / Client Secret)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# IDs dos items conectados (ex.: o item do MeuPluggy), separados por vírgula.
# Também dá para adicionar pela interface, em "Conexões".
PLUGGY_ITEM_IDS=

PORT=3000
# HOST=0.0.0.0   # padrão: 0.0.0.0 dentro de container, 127.0.0.1 fora
# DEMO=1   # força dados fictícios

# Docker Compose
# APP_PORT=3010            # porta no host (WSL/Windows) → http://localhost:3010
# POSTGRES_PASSWORD=troque-esta-senha
# SYNC_INTERVAL_HOURS=6     # sincronização automática do histórico

# Webhooks Pluggy (produção): URL pública HTTPS do app. Com ela, o app cadastra os webhooks na Pluggy ao subir
# e sincroniza assim que a Pluggy avisar. O segredo da URL é gerado e guardado no banco (ou defina WEBHOOK_SECRET).
# PUBLIC_URL=https://canguinha.seudominio.com.br
# WEBHOOK_SECRET=

# Login com Google (obrigatório quando PUBLIC_URL está definida)
# Crie um "ID do cliente OAuth" (tipo Aplicativo da Web) em https://console.cloud.google.com/apis/credentials
# URI de redirecionamento autorizado: <PUBLIC_URL>/auth/google/callback  (local: http://localhost:3010/auth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOWED_EMAILS=voce@gmail.com           # e-mails com acesso, separados por vírgula

# Bot do Telegram (opcional): comandos /diaria, /semana, /mes, /fatura e /saldo.
# Crie o bot com o @BotFather (/newbot) e cole o token. Mande /start para o bot: ele responde com o seu chat id.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=123456789     # chats autorizados, separados por vírgula
# TELEGRAM_CATEGORIZE=0                   # desliga as perguntas de categoria de despesas novas
